{
  "version": 3,
  "builds": [
    { 
      "src": "index.js", 
      "use": "@vercel/node" 
    }
  ],
  "routes": [
    {
      "src": "/auth/(.*)",
      "dest": "/index.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.js"
    }  
  ]
}
