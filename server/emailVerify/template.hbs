<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Notes App Email Verification</title>
  </head>
  <body style="margin:0; padding:0; font-family: 'Segoe UI', Arial, sans-serif; background-color:#f9fafb;">
    <table width="100%" cellspacing="0" cellpadding="0" border="0" style="background-color:#f9fafb; padding:40px 0;">
      <tr>
        <td align="center">
          <table width="600" cellspacing="0" cellpadding="0" border="0" style="background:#ffffff; border-radius:10px; box-shadow:0 4px 20px rgba(0,0,0,0.1); overflow:hidden;">
            
            <!-- Header -->
            <tr>
              <td align="center" style="background-color:#365CCE; color:#ffffff; padding:40px 20px; text-align:center;">
                <h1 style="margin:0; font-size:26px; font-weight:700;">Verify Your Email</h1>
                <p style="margin-top:10px; font-size:16px; font-weight:300;">
                  Welcome to <strong>Notes App</strong> — your personal space for ideas, lists, and thoughts!
                </p>
              </td>
            </tr>

            <!-- Main Content -->
            <tr>
              <td style="padding:40px 30px; color:#333;">
                <h2 style="font-size:20px; font-weight:600; margin-bottom:15px;">Hi there,</h2>

                <p style="font-size:15px; line-height:1.7; color:#333; margin-bottom:20px;">
                  Welcome to <strong>Notes App</strong> — your go-to app to capture thoughts, organize your day, and manage ideas effortlessly.
                </p>

                <p style="font-size:15px; line-height:1.7; color:#333; margin-bottom:20px;">
                  Please verify your email to activate your account and start creating your first note securely.
                </p>

                <!-- Button -->
                <p style="text-align:center; margin:30px 0;">
                  <a href="{{CLIENT_URL}}/verify/{{token}}" target="_blank" style="display:inline-block; background-color:#365CCE; color:#ffffff; text-decoration:none; font-weight:500; padding:12px 30px; border-radius:8px;">
                    Verify Email
                  </a>
                </p>

                <p style="font-size:15px; line-height:1.7; color:#333; margin-bottom:20px;">
                  Once verified, you can access all your notes from any device, anytime — your ideas, always safe and synced.
                </p>

                <div style="margin-top:30px; color:#374151; font-weight:500;">
                  <p>Welcome aboard, and happy note-taking!</p>
                  <p style="margin-top:8px;">
                    Best regards,<br />
                    <span style="font-weight:600;">The Notes App Team 📝</span>
                  </p>
                </div>
              </td>
            </tr>

            <!-- Footer Text -->
            <tr>
              <td style="font-size:13px; color:#6b7280; padding:25px 30px; border-top:1px solid #e5e7eb; text-align:center;">
                This email was sent from
                <a href="mailto:support@notesapp.com" style="color:#365CCE; text-decoration:none;">support@notesapp.com</a>.<br />
                If you no longer wish to receive emails from us, you can
                <a href="#" style="color:#365CCE; text-decoration:none;">unsubscribe</a> or
                <a href="#" style="color:#365CCE; text-decoration:none;">manage your preferences</a>.
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td style="background-color:#365CCE; color:#ffffff; text-align:center; padding:15px 0; font-size:13px;">
                © 2025 Notes App. All rights reserved.
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
